/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hml_index: hml_index {
        compatible = "zmk,behavior-hold-tap";
        label = "HML_INDEX";
        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        hold-while-undecided;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* right hand alpha keys */
          6  7  8  9  10 11 12
          19 20 21 22 23 24 25
          32 33 34 35 36 37 38
          45 46 47 48 49 50
          57 58 59 60 61 62
        >;
      };

      hml_middle: hml_middle {
        compatible = "zmk,behavior-hold-tap";
        label = "HML_MIDDLE";
        #binding-cells = <2>;
        tapping-term-ms = <270>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        hold-while-undecided;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* right hand alpha keys */
          6  7  8  9  10 11 12
          19 20 21 22 23 24 25
          32 33 34 35 36 37 38
          45 46 47 48 49 50
          57 58 59 60 61 62
        >;
      };

      hml_ring: hml_ring {
        compatible = "zmk,behavior-hold-tap";
        label = "HML_RING";
        #binding-cells = <2>;
        tapping-term-ms = <300>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* right hand alpha keys */
          6  7  8  9  10 11 12
          19 20 21 22 23 24 25
          32 33 34 35 36 37 38
          45 46 47 48 49 50
          57 58 59 60 61 62
        >;
      };

      hml_pinky: hml_pinky {
        compatible = "zmk,behavior-hold-tap";
        label = "HML_PINKY";
        #binding-cells = <2>;
        tapping-term-ms = <330>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* right hand alpha keys */
          6  7  8  9  10 11 12
          19 20 21 22 23 24 25
          32 33 34 35 36 37 38
          45 46 47 48 49 50
          57 58 59 60 61 62
        >;
      };

      hmr_index: hmr_index {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR_INDEX";
        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        hold-while-undecided;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* left hand alpha keys */
          0  1  2  3  4  5
          13 14 15 16 17 18
          26 27 28 29 30 31
          39 40 41 42 43 44
          51 52 53 54 55 56
        >;
      };

      hmr_middle: hmr_middle {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR_MIDDLE";
        #binding-cells = <2>;
        tapping-term-ms = <270>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        hold-while-undecided;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* left hand alpha keys */
          0  1  2  3  4  5
          13 14 15 16 17 18
          26 27 28 29 30 31
          39 40 41 42 43 44
          51 52 53 54 55 56
        >;
      };

      hmr_ring: hmr_ring {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR_RING";
        #binding-cells = <2>;
        tapping-term-ms = <300>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* left hand alpha keys */
          0  1  2  3  4  5
          13 14 15 16 17 18
          26 27 28 29 30 31
          39 40 41 42 43 44
          51 52 53 54 55 56
        >;
      };

      hmr_pinky: hmr_pinky {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR_PINKY";
        #binding-cells = <2>;
        tapping-term-ms = <330>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        bindings = <&kp>, <&kp>;
        hold-trigger-key-positions = <
          /* left hand alpha keys */
          0  1  2  3  4  5
          13 14 15 16 17 18
          26 27 28 29 30 31
          39 40 41 42 43 44
          51 52 53 54 55 56
        >;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &none  &none                        &kp KEY_LH_C4R1             &kp KEY_LH_C3R1                &none                         &none            &none                                                                                             &none  &none               &none                         &none                          &kp KEY_RH_C3R1             &kp KEY_RH_C4R1             &none
        &none  &kp KEY_LH_C5R2              &kp KEY_LH_C4R2             &kp KEY_LH_C3R2                &kp KEY_LH_C2R2               &kp KEY_LH_C1R2  &none                                                                                             &none  &kp KEY_RH_C1R2     &kp KEY_RH_C2R2               &kp KEY_RH_C3R2                &&kp KEY_RH_C4R2            &kp KEY_RH_C5R2             &none
        &none  &hml_pinky LGUI KEY_LH_C5R3  &hml_ring LALT KEY_LH_C4R3  &hml_middle LCRTL KEY_LH_C3R3  &hml_index LSHFT KEY_LH_C2R3  &kp KEY_LH_C1R3  &none                 &kp KEY_LH_T1  &kp KEY_LH_T2  &kp KEY_RH_T1  &kp KEY_RH_T2                  &none  &kp KEY_RH_C1R3     &hmr_index RSHFT KEY_RH_C2R3  &hmr_middle RCTRL KEY_RH_C3R3  &hmr_ring LALT KEY_RH_C4R3  &hmr_pinky RGUI KEY_RH_C5R3 &none
        &none  &kp KEY_LH_C5R4              &kp KEY_LH_C4R4             &kp KEY_LH_C3R4                &kp KEY_LH_C2R4               &kp KEY_LH_C1R4                                       &none          &none                                                &kp KEY_RH_C1R4     &kp KEY_RH_C2R4               &kp KEY_RH_C3R4                &&kp KEY_RH_C4R4            &kp KEY_RH_C5R4             &none
        &none  &kp KEY_LH_C5R5              &kp KEY_LH_C4R5             &kp KEY_LH_C3R5                &kp KEY_LH_C2R5                                       &kp KEY_LH_T4  &kp KEY_LH_T5  &none          &none          &kp KEY_RH_T5   &kp KEY_RH_T4                             &kp KEY_RH_C2R5               &kp KEY_RH_C3R5                &&kp KEY_RH_C4R5            &kp KEY_RH_C5R5             &none
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                            &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans         &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                      &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans               &trans &trans &trans  &trans  &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
