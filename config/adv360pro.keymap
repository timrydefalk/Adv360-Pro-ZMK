/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

       layer_Dvorak {
            bindings = <
    &none                   &none                                   &kp KEY_LH_C4R1                         &kp KEY_LH_C3R1                         &caps_word                               &sticky_key_modtap LSFT LSFT            &none                                                                                                                                                                                                             &none &sticky_key_modtap RSFT RSFT   &caps_word                               &kp KEY_RH_C3R1                          &kp KEY_RH_C4R1                          &none                                   &none
    &none                   &kp KEY_LH_C5R2                         &kp KEY_LH_C4R2                         &kp KEY_LH_C3R2                         &kp KEY_LH_C2R2                          &kp KEY_LH_C1R2                         &none                                                                                                                                                                                                             &none &kp KEY_RH_C1R2                &kp KEY_RH_C2R2                          &kp KEY_RH_C3R2                          &kp KEY_RH_C4R2                          &kp KEY_RH_C5R2                         &none
    &tog LAYER_Typing       &hml_pinky KEY_LH_C5R3 LAYER_Dvorak     &hml_ring KEY_LH_C4R3 LAYER_Dvorak      &hml_middle KEY_LH_C3R3 LAYER_Dvorak    &hml_index KEY_LH_C2R3 LAYER_Dvorak      &kp KEY_LH_C1R3                         &none                                   &thumb LAYER_Number KEY_LH_T1     &thumb LAYER_Function KEY_LH_T2   &thumb LAYER_World KEY_RH_T2  &thumb LAYER_Symbol KEY_RH_T1                                           &none &kp KEY_RH_C1R3                &hmr_index KEY_RH_C2R3 LAYER_Dvorak    &hmr_middle KEY_RH_C3R3 LAYER_Dvorak   &hmr_ring KEY_RH_C4R3 LAYER_Dvorak     &hmr_pinky KEY_RH_C5R3 LAYER_Dvorak &none
    &none                   &kp KEY_LH_C5R4                         &kp KEY_LH_C4R4                         &kp KEY_LH_C3R4                         &kp KEY_LH_C2R4                          &kp KEY_LH_C1R4                                                                                                   &none                             &none                                                                                                       &kp KEY_RH_C1R4                &kp KEY_RH_C2R4                          &kp KEY_RH_C3R4                          &kp KEY_RH_C4R4                          &kp KEY_RH_C5R4                         &none
    &magic LAYER_Magic 0    &kp KEY_LH_C5R5                         &kp KEY_LH_C4R5                         &kp KEY_LH_C3R5                         &kp KEY_LH_C2R5                                                                           &thumb LAYER_Number KEY_LH_T4  &thumb LAYER_Function KEY_LH_T5   &none                             &none                         &kp KEY_RH_T5                  &LAYER_Symbol KEY_RH_T4                                                       &kp KEY_RH_C2R5                          &kp KEY_RH_C3R5                          &kp KEY_RH_C4R5                          &kp KEY_RH_C5R5                         &magic LAYER_Magic 0
            >;
        };

        layer_Typing {
            bindings = <
    &trans &trans              &trans              &trans              &trans             &trans &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &trans              &trans              &trans              &trans             &trans &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY &trans &trans          &trans &trans  &trans &trans        &trans &trans &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY &trans
    &trans &trans              &trans              &trans              &trans             &trans                        &trans  &trans                      &trans &trans               &trans               &trans               &trans              &trans
    &trans &trans              &trans              &trans              &trans                             &trans &trans &trans  &trans &trans &trans               &trans               &trans               &trans               &trans              &trans
            >;
        };

        layer_LeftPinky {
            bindings = <
    &trans &trans                       &trans                       &trans                       &trans                       &trans                      &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_pinky_tap KEY_LH_C5R2  &hml_pinky_tap KEY_LH_C4R2  &hml_pinky_tap KEY_LH_C3R2  &hml_pinky_tap KEY_LH_C2R2  &hml_pinky_tap KEY_LH_C1R2 &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &none                        &LeftPinkyRingy              &LeftPinkyMiddy              &LeftPinkyIndex              &hml_pinky_tap KEY_LH_C1R3 &trans          &trans &trans  &trans &trans        &trans &trans &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY &trans
    &trans &hml_pinky_tap KEY_LH_C5R4  &hml_pinky_tap KEY_LH_C4R4  &hml_pinky_tap KEY_LH_C3R4  &hml_pinky_tap KEY_LH_C2R4  &hml_pinky_tap KEY_LH_C1R4                        &trans  &trans                      &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_pinky_tap KEY_LH_C5R5  &hml_pinky_tap KEY_LH_C4R5  &hml_pinky_tap KEY_LH_C3R5  &hml_pinky_tap KEY_LH_C2R5                                       &trans &trans &trans  &trans &trans &trans               &trans               &trans               &trans               &trans              &trans
            >;
        };

        layer_LeftRingy {
            bindings = <
    &trans &trans                       &trans                       &trans                       &trans                       &trans                      &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_ring_tap KEY_LH_C5R2  &hml_ring_tap KEY_LH_C4R2  &hml_ring_tap KEY_LH_C3R2  &hml_ring_tap KEY_LH_C2R2  &hml_ring_tap KEY_LH_C1R2 &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &LeftRingyPinky              &none                        &LeftRingyMiddy              &LeftRingyIndex              &hml_ring_tap KEY_LH_C1R3 &trans          &trans &trans  &trans &trans        &trans &trans &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY &trans
    &trans &hml_ring_tap KEY_LH_C5R4  &hml_ring_tap KEY_LH_C4R4  &hml_ring_tap KEY_LH_C3R4  &hml_ring_tap KEY_LH_C2R4  &hml_ring_tap KEY_LH_C1R4                        &trans  &trans                      &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_ring_tap KEY_LH_C5R5  &hml_ring_tap KEY_LH_C4R5  &hml_ring_tap KEY_LH_C3R5  &hml_ring_tap KEY_LH_C2R5                                       &trans &trans &trans  &trans &trans &trans               &trans               &trans               &trans               &trans              &trans
            >;
        };

        layer_LeftMiddy {
            bindings = <
    &trans &trans                       &trans                       &trans                       &trans                       &trans                      &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_middle_tap KEY_LH_C5R2  &hml_middle_tap KEY_LH_C4R2  &hml_middle_tap KEY_LH_C3R2  &hml_middle_tap KEY_LH_C2R2  &hml_middle_tap KEY_LH_C1R2 &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &LeftMiddyPinky              &LeftMiddyRingy              &none                        &LeftMiddyIndex              &hml_middle_tap KEY_LH_C1R3 &trans          &trans &trans  &trans &trans        &trans &trans &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY &trans
    &trans &hml_middle_tap KEY_LH_C5R4  &hml_middle_tap KEY_LH_C4R4  &hml_middle_tap KEY_LH_C3R4  &hml_middle_tap KEY_LH_C2R4  &hml_middle_tap KEY_LH_C1R4                        &trans  &trans                      &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_middle_tap KEY_LH_C5R5  &hml_middle_tap KEY_LH_C4R5  &hml_middle_tap KEY_LH_C3R5  &hml_middle_tap KEY_LH_C2R5                                       &trans &trans &trans  &trans &trans &trans               &trans               &trans               &trans               &trans              &trans
            >;
        };

        layer_LeftIndex {
            bindings = <
    &trans &trans                       &trans                       &trans                       &trans                       &trans                      &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_index_tap KEY_LH_C5R2  &hml_index_tap KEY_LH_C4R2  &hml_index_tap KEY_LH_C3R2  &hml_index_tap KEY_LH_C2R2  &hml_index_tap KEY_LH_C1R2 &trans                                              &trans &trans &trans               &trans               &trans               &trans              &trans
    &trans &LeftIndexPinky              &LeftIndexRingy              &LeftIndexMiddy              &none                        &hml_index_tap KEY_LH_C1R3 &trans          &trans &trans  &trans &trans        &trans &trans &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY &trans
    &trans &hml_index_tap KEY_LH_C5R4  &hml_index_tap KEY_LH_C4R4  &hml_index_tap KEY_LH_C3R4  &hml_index_tap KEY_LH_C2R4  &hml_index_tap KEY_LH_C1R4                        &trans  &trans                      &trans &trans               &trans               &trans               &trans              &trans
    &trans &hml_index_tap KEY_LH_C5R5  &hml_index_tap KEY_LH_C4R5  &hml_index_tap KEY_LH_C3R5  &hml_index_tap KEY_LH_C2R5                                       &trans &trans &trans  &trans &trans &trans               &trans               &trans               &trans               &trans              &trans
            >;
        };

        layer_RightPinky {
            bindings = <
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &trans                        &trans                        &trans                        &trans                        &trans                       &trans
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &hmr_pinky_tap KEY_RH_C1R2  &hmr_pinky_tap KEY_RH_C2R2  &hmr_pinky_tap KEY_RH_C3R2  &hmr_pinky_tap KEY_RH_C4R2  &hmr_pinky_tap KEY_RH_C5R2 &trans
    &trans &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY &trans &trans         &trans &trans  &trans &trans        &trans &hmr_pinky_tap KEY_RH_C1R3              &RightPinkyIndex              &RightPinkyMiddy              &RightPinkyRingy                         &none &trans
    &trans &trans              &trans              &trans              &trans             &trans                       &trans  &trans                      &hmr_pinky_tap KEY_RH_C1R4  &hmr_pinky_tap KEY_RH_C2R4  &hmr_pinky_tap KEY_RH_C3R4  &hmr_pinky_tap KEY_RH_C4R4  &hmr_pinky_tap KEY_RH_C5R4 &trans
    &trans &trans              &trans              &trans              &trans                            &trans &trans &trans  &trans &trans &trans                                      &hmr_pinky_tap KEY_RH_C2R5  &hmr_pinky_tap KEY_RH_C3R5  &hmr_pinky_tap KEY_RH_C4R5  &hmr_pinky_tap KEY_RH_C5R5 &trans
            >;
        };

        layer_RightRingy {
            bindings = <
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &trans                        &trans                        &trans                        &trans                        &trans                       &trans
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &hmr_ring_tap KEY_RH_C1R2  &hmr_ring_tap KEY_RH_C2R2  &hmr_ring_tap KEY_RH_C3R2  &hmr_ring_tap KEY_RH_C4R2  &hmr_ring_tap KEY_RH_C5R2 &trans
    &trans &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY &trans &trans         &trans &trans  &trans &trans        &trans &hmr_ring_tap KEY_RH_C1R3              &RightRingyIndex              &RightRingyMiddy                         &none              &RightRingyPinky &trans
    &trans &trans              &trans              &trans              &trans             &trans                       &trans  &trans                      &hmr_ring_tap KEY_RH_C1R4  &hmr_ring_tap KEY_RH_C2R4  &hmr_ring_tap KEY_RH_C3R4  &hmr_ring_tap KEY_RH_C4R4  &hmr_ring_tap KEY_RH_C5R4 &trans
    &trans &trans              &trans              &trans              &trans                            &trans &trans &trans  &trans &trans &trans                                      &hmr_ring_tap KEY_RH_C2R5  &hmr_ring_tap KEY_RH_C3R5  &hmr_ring_tap KEY_RH_C4R5  &hmr_ring_tap KEY_RH_C5R5 &trans
            >;
        };

        layer_RightMiddy {
            bindings = <
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &trans                        &trans                        &trans                        &trans                        &trans                       &trans
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &hmr_middle_tap KEY_RH_C1R2  &hmr_middle_tap KEY_RH_C2R2  &hmr_middle_tap KEY_RH_C3R2  &hmr_middle_tap KEY_RH_C4R2  &hmr_middle_tap KEY_RH_C5R2 &trans
    &trans &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY &trans &trans         &trans &trans  &trans &trans        &trans &hmr_middle_tap KEY_RH_C1R3              &RightMiddyIndex                         &none              &RightMiddyRingy              &RightMiddyPinky &trans
    &trans &trans              &trans              &trans              &trans             &trans                       &trans  &trans                      &hmr_middle_tap KEY_RH_C1R4  &hmr_middle_tap KEY_RH_C2R4  &hmr_middle_tap KEY_RH_C3R4  &hmr_middle_tap KEY_RH_C4R4  &hmr_middle_tap KEY_RH_C5R4 &trans
    &trans &trans              &trans              &trans              &trans                            &trans &trans &trans  &trans &trans &trans                                      &hmr_middle_tap KEY_RH_C2R5  &hmr_middle_tap KEY_RH_C3R5  &hmr_middle_tap KEY_RH_C4R5  &hmr_middle_tap KEY_RH_C5R5 &trans
            >;
        };

        layer_RightIndex {
            bindings = <
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &trans                        &trans                        &trans                        &trans                        &trans                       &trans
    &trans &trans              &trans              &trans              &trans             &trans &trans                                             &trans &hmr_index_tap KEY_RH_C1R2  &hmr_index_tap KEY_RH_C2R2  &hmr_index_tap KEY_RH_C3R2  &hmr_index_tap KEY_RH_C4R2  &hmr_index_tap KEY_RH_C5R2 &trans
    &trans &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY &trans &trans         &trans &trans  &trans &trans        &trans &hmr_index_tap KEY_RH_C1R3                         &none              &RightIndexMiddy              &RightIndexRingy              &RightIndexPinky &trans
    &trans &trans              &trans              &trans              &trans             &trans                       &trans  &trans                      &hmr_index_tap KEY_RH_C1R4  &hmr_index_tap KEY_RH_C2R4  &hmr_index_tap KEY_RH_C3R4  &hmr_index_tap KEY_RH_C4R4  &hmr_index_tap KEY_RH_C5R4 &trans
    &trans &trans              &trans              &trans              &trans                            &trans &trans &trans  &trans &trans &trans                                      &hmr_index_tap KEY_RH_C2R5  &hmr_index_tap KEY_RH_C3R5  &hmr_index_tap KEY_RH_C4R5  &hmr_index_tap KEY_RH_C5R5 &trans
            >;
        };

