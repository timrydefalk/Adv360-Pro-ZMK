#define LAYER_Mouse 13
#define LAYER_MouseSlow 14
#define LAYER_MouseFast 15
#define LAYER_MouseWarp 16
#define LAYER_System 17
#define LAYER_World 18
#define LAYER_Gaming 19
#define LAYER_Magic 20

#define LEFT_PINKY_KEY  KEY_LH_C5R3
#define LEFT_RINGY_KEY  KEY_LH_C4R3
#define LEFT_MIDDY_KEY  KEY_LH_C3R3
#define LEFT_INDEX_KEY  KEY_LH_C2R3

#define RIGHT_PINKY_KEY KEY_RH_C5R3
#define RIGHT_RINGY_KEY KEY_RH_C4R3
#define RIGHT_MIDDY_KEY KEY_RH_C3R3
